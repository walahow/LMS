# Supabase project settings → API (supports both NEXT_PUBLIC_ and plain SUPABASE_ naming)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative names recognized automatically on Vercel:
# SUPABASE_URL=
# SUPABASE_KEY=

# Supabase project settings → API → service_role. Server-only — used only for
# admin user provisioning. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini Flash via its OpenAI-compatible endpoint (see docs/PLAN.md §5).
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-1.5-flash
